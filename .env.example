NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://agendasaas:agendasaas@localhost:5432/agendasaas

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m

REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Optional — defaults shown. Controls the "esqueci minha senha" flow.
# PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=60
# PASSWORD_RESET_COOLDOWN_MINUTES=2

SEED_PLATFORM_ADMIN_EMAIL=admin@agendasaas.local
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# Base URL of the client-facing frontend — used to build links inside outbound notifications
# and password-reset e-mails (e.g. "ver meus agendamentos", "redefinir senha").
# FRONTEND_URL=http://localhost:3001

# All optional — unset means Resend runs in log-only mode and the payment gateway runs in
# sandbox mode (see ResendEmailNotifier/HttpPaymentGatewayAdapter).
# Resend (https://resend.com) — get an API key from the dashboard. Leave unset to log e-mails
# instead of sending them.
# RESEND_API_KEY=
# NOTIFICATIONS_EMAIL_FROM=OffVance Agendamentos <onboarding@resend.dev>
# PAYMENT_GATEWAY_API_URL=
# PAYMENT_GATEWAY_API_TOKEN=
# Required once PAYMENT_GATEWAY_API_URL is set — authenticates POST /payments/webhook.
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

# All optional — defaults shown. Controls where the local-disk FileStoragePort adapter reads/
# writes uploaded logos/photos, and the caps enforced on upload.
# MEDIA_STORAGE_ROOT=./uploads
# MEDIA_PUBLIC_BASE_URL=http://localhost:3000
# MEDIA_MAX_UPLOAD_BYTES=5242880
# MEDIA_MAX_GALLERY_PHOTOS=12
