# URL pública da API (backend NestJS). Lida em escopo de módulo em src/lib/api/client.ts, então
# é INLINADA NO BUILD — trocar o valor sem rodar `next build` de novo não tem efeito nenhum.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Opcional. "true" mostra na tela de login as contas fictícias criadas por
# prisma/seed-demo.ts (Fase 27 — deploy de portfólio). Deixe unset em qualquer ambiente com
# dados/clientes reais.
# NEXT_PUBLIC_DEMO_MODE=true
